<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PracticoMobileApp.TablaPosicionesPage"
             Title="Tabla de Posiciones">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="10">

        <!-- Header con título -->
        <Label Grid.Row="0"
               Text="Clasificación"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="{StaticResource TextoPrincipal}"
               HorizontalOptions="Center"
               Margin="0,10,0,20"/>

        <!-- Mi posición destacada -->
        <Border Grid.Row="1"
                x:Name="MiPosicionBorder"
                IsVisible="False"
                BackgroundColor="{StaticResource VerdeLight}"
                Stroke="{StaticResource VerdePrimary}"
                StrokeThickness="2"
                Padding="15"
                Margin="0,0,0,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0"
                       x:Name="MiPosicionLabel"
                       Text="1°"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource VerdePrimaryDark}"
                       VerticalOptions="Center"/>
                <Label Grid.Column="1"
                       Text="Tu posición"
                       FontSize="16"
                       TextColor="{StaticResource TextoPrincipal}"
                       VerticalOptions="Center"
                       Margin="10,0,0,0"/>
                <Label Grid.Column="2"
                       x:Name="MisPuntosLabel"
                       Text="0 pts"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource VerdePrimaryDark}"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- Tabla de posiciones -->
        <Border Grid.Row="2"
                Stroke="{StaticResource VerdeLight}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource BackgroundCard}"
                Padding="0"
                Margin="0,0,0,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>

            <CollectionView x:Name="PosicionesCollectionView"
                            SelectionMode="None">

                <!-- Header de la tabla -->
                <CollectionView.Header>
                    <Grid BackgroundColor="{StaticResource VerdePrimary}"
                          Padding="15,12"
                          ColumnDefinitions="60,*,80">
                        <Label Grid.Column="0"
                               Text="Pos."
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="White"/>
                        <Label Grid.Column="1"
                               Text="Jugador"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="White"/>
                        <Label Grid.Column="2"
                               Text="Puntos"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="White"
                               HorizontalOptions="End"/>
                    </Grid>
                </CollectionView.Header>

                <!-- Template para cada fila -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0" Margin="0" Stroke="Transparent">
                            <Grid Padding="15,12"
                                  ColumnDefinitions="60,*,80">

                                <!-- Color de fondo para el usuario actual -->
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid"
                                                 Binding="{Binding EsUsuarioActual}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource VerdeLight}"/>
                                    </DataTrigger>
                                </Grid.Triggers>

                                <!-- Posición con medalla para top 3 -->
                                <HorizontalStackLayout Grid.Column="0" Spacing="5">
                                    <Label Text="{Binding Posicion, StringFormat='{0}°'}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextoPrincipal}"
                                           VerticalOptions="Center"/>

                                    <!-- Medalla de oro -->
                                    <Label IsVisible="{Binding Posicion, Converter={StaticResource IntToBoolConverter}, ConverterParameter='1'}"
                                           Text="🥇"
                                           FontSize="18"/>
                                    <!-- Medalla de plata -->
                                    <Label IsVisible="{Binding Posicion, Converter={StaticResource IntToBoolConverter}, ConverterParameter='2'}"
                                           Text="🥈"
                                           FontSize="18"/>
                                    <!-- Medalla de bronce -->
                                    <Label IsVisible="{Binding Posicion, Converter={StaticResource IntToBoolConverter}, ConverterParameter='3'}"
                                           Text="🥉"
                                           FontSize="18"/>
                                </HorizontalStackLayout>

                                <!-- Nombre del jugador -->
                                <Label Grid.Column="1"
                                       Text="{Binding UsuarioNombre}"
                                       FontSize="15"
                                       TextColor="{StaticResource TextoPrincipal}"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding EsUsuarioActual}"
                                                     Value="True">
                                            <Setter Property="FontAttributes" Value="Bold"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Puntos -->
                                <Label Grid.Column="2"
                                       Text="{Binding Puntos}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource VerdePrimary}"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Mensaje cuando no hay datos -->
                <CollectionView.EmptyView>
                    <StackLayout Padding="20" VerticalOptions="Center">
                        <Label Text="No hay participantes en esta penca todavía"
                               FontSize="16"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource TextoSecundario}"/>
                    </StackLayout>
                </CollectionView.EmptyView>

            </CollectionView>
        </Border>

        <!-- Botón de actualizar -->
        <Button Grid.Row="3"
                x:Name="ActualizarButton"
                Text="Actualizar"
                Clicked="OnActualizarClicked"
                BackgroundColor="{StaticResource VerdePrimary}"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="50"
                FontAttributes="Bold"/>

        <!-- Indicador de carga -->
        <ActivityIndicator Grid.Row="2"
                          x:Name="LoadingIndicator"
                          IsRunning="False"
                          IsVisible="False"
                          Color="{StaticResource VerdePrimary}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center"/>
    </Grid>

</ContentPage>
