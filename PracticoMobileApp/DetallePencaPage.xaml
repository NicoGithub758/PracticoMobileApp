<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PracticoMobileApp.DetallePencaPage"
             Title="Detalle de Penca">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Tarjeta de info de la penca -->
            <Border Stroke="{StaticResource VerdeLight}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource BackgroundCard}"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label x:Name="NombrePencaLabel"
                           Text="Nombre de la Penca"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextoPrincipal}"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0"
                               x:Name="DeporteLabel"
                               Text="Deporte: -"
                               FontSize="14"
                               TextColor="{StaticResource TextoSecundario}"/>
                        <Label Grid.Row="0" Grid.Column="1"
                               x:Name="EquiposLabel"
                               Text="Equipos: -"
                               FontSize="14"
                               TextColor="{StaticResource TextoSecundario}"/>
                        <Label Grid.Row="1" Grid.Column="0"
                               x:Name="CostoLabel"
                               Text="Costo: -"
                               FontSize="14"
                               TextColor="{StaticResource TextoSecundario}"/>
                        <Label Grid.Row="1" Grid.Column="1"
                               x:Name="EstadoLabel"
                               Text="Estado: -"
                               FontSize="14"
                               TextColor="{StaticResource TextoSecundario}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Tarjeta de mi participacion -->
            <Border x:Name="ParticipacionBorder"
                    Stroke="{StaticResource ColorExito}"
                    StrokeThickness="2"
                    BackgroundColor="{StaticResource VerdeLight}"
                    Padding="20"
                    IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Tu Participacion"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource ColorExito}"/>
                    <Label x:Name="MisPuntosLabel"
                           Text="Puntos: 0"
                           FontSize="14"
                           TextColor="{StaticResource TextoPrincipal}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Mensaje si no participa -->
            <Border x:Name="NoParticipaBorder"
                Stroke="{StaticResource ColorAdvertencia}"
                StrokeThickness="2"
                BackgroundColor="#FFF7E5"
                Padding="20"
                IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="No participás en esta penca todavía"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#8A5A12"/>
                            <Label Text="Para hacer predicciones y aparecer en la tabla de posiciones, hacé el pago de participación."
                       FontSize="13"
                       TextColor="#8A5A12"/>

                            <!-- Boton de pago -->
                            <Button x:Name="BtnParticipar"
                        Text="Participar con PayPal"
                        Clicked="OnParticiparClicked"
                        BackgroundColor="{StaticResource VerdePrimary}"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        Margin="0,8,0,0"/>
                        </VerticalStackLayout>
            </Border>

            <!-- Botones de accion -->
            <VerticalStackLayout Spacing="12">

                <Button x:Name="BtnPosiciones"
                        Text="Ver Tabla de Posiciones"
                        Clicked="OnVerPosicionesClicked"
                        BackgroundColor="{StaticResource VerdePrimary}"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="55"
                        FontSize="16"
                        FontAttributes="Bold"/>

                <Button x:Name="BtnPredicciones"
                        Text="Hacer Predicciones"
                        Clicked="OnHacerPrediccionesClicked"
                        BackgroundColor="{StaticResource VerdePrimaryDark}"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="55"
                        FontSize="16"
                        FontAttributes="Bold"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
