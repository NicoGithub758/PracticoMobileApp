<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PracticoMobileApp.LoginInternoPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0F0F0F">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Fill"
                             Padding="40,60"
                             Spacing="0">

            <!-- Logo -->
            <Frame WidthRequest="80"
                   HeightRequest="80"
                   CornerRadius="20"
                   BackgroundColor="#1A1A2E"
                   BorderColor="#4285F4"
                   HorizontalOptions="Center"
                   Margin="0,0,0,24">
                <Label Text="🏆"
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Frame>

            <Label Text="Iniciar sesión"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   Margin="0,0,0,4"/>

            <Label x:Name="SitioLabel"
                   Text=""
                   FontSize="13"
                   TextColor="#4285F4"
                   HorizontalOptions="Center"
                   Margin="0,0,0,32"/>

            <!-- Email -->
            <Label Text="Email"
                   FontSize="13"
                   TextColor="#AAAAAA"
                   Margin="0,0,0,4"/>
            <Frame BackgroundColor="#1A1A2E"
                   BorderColor="#333333"
                   CornerRadius="10"
                   Padding="14,0"
                   HeightRequest="50"
                   HasShadow="False"
                   Margin="0,0,0,16">
                <Entry x:Name="EmailEntry"
                       Placeholder="tu@email.com"
                       PlaceholderColor="#666666"
                       TextColor="White"
                       Keyboard="Email"
                       BackgroundColor="Transparent"/>
            </Frame>

            <!-- Password -->
            <Label Text="Contraseña"
                   FontSize="13"
                   TextColor="#AAAAAA"
                   Margin="0,0,0,4"/>
            <Frame BackgroundColor="#1A1A2E"
                   BorderColor="#333333"
                   CornerRadius="10"
                   Padding="14,0"
                   HeightRequest="50"
                   HasShadow="False"
                   Margin="0,0,0,24">
                <Entry x:Name="PasswordEntry"
                       Placeholder="Tu contraseña"
                       PlaceholderColor="#666666"
                       TextColor="White"
                       IsPassword="True"
                       BackgroundColor="Transparent"/>
            </Frame>

            <!-- Boton de login -->
            <Frame x:Name="LoginButton"
                   BackgroundColor="#4285F4"
                   BorderColor="Transparent"
                   CornerRadius="14"
                   Padding="0"
                   HeightRequest="56"
                   HasShadow="True">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLoginTapped"/>
                </Frame.GestureRecognizers>
                <Label Text="Ingresar"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
            </Frame>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#4285F4"
                               Margin="0,20,0,0"/>

            <Label x:Name="ErrorLabel"
                   Text=""
                   TextColor="#FF6B6B"
                   FontSize="13"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   IsVisible="False"
                   Margin="0,16,0,0"/>

            <!-- Volver -->
            <Label Text="← Volver"
                   FontSize="13"
                   TextColor="#888888"
                   HorizontalOptions="Center"
                   Margin="0,32,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverTapped"/>
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
