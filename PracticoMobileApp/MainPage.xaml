<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PracticoMobileApp.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <!-- Logo -->
            <Image Source="pencauy_logo.svg"
                   HeightRequest="120"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Margin="0,20,0,10"/>

            <Label x:Name="WelcomeLabel"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextoPrincipal}"
                   HorizontalOptions="Center"/>

            <Label x:Name="SitioLabel"
                   FontSize="14"
                   TextColor="{StaticResource VerdePrimary}"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Label Text="Bienvenido a tupenca.uy"
                   FontSize="16"
                   TextColor="{StaticResource TextoSecundario}"
                   HorizontalOptions="Center"/>

            <Button Text="Ver Pencas"
                    Clicked="OnVerPencasClicked"
                    Style="{StaticResource BotonPrimario}"
                    Margin="0,12,0,0"/>

            <Button Text="Notificaciones"
                    Clicked="OnConfiguracionTapped"
                    Style="{StaticResource BotonSecundario}"
                    Margin="0,0,0,0"/>

            <Button Text="Cerrar sesión"
                    Clicked="OnCerrarSesionTapped"
                    Style="{StaticResource BotonPeligro}"
                    HorizontalOptions="Center"
                    Margin="0,30,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
