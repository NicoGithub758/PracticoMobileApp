<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PracticoMobileApp.SolicitudPendientePage"
             Shell.NavBarIsVisible="False">

    <Grid>
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Fill"
                             Padding="40"
                             Spacing="0">

            <!-- Logo del sitio (circular) -->
            <Image x:Name="SitioLogoImage"
                   Source="pencauy_logo.svg"
                   HeightRequest="140"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <!-- Icono de reloj -->
            <Label Text="⏳"
                   FontSize="40"
                   HorizontalOptions="Center"
                   Margin="0,0,0,12"/>

            <Label Text="Solicitud enviada"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextoPrincipal}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,16"/>

            <Label x:Name="MensajeLabel"
                   Text="Tu solicitud fue enviada correctamente."
                   FontSize="15"
                   TextColor="{StaticResource TextoSecundario}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,24"/>

            <Frame BackgroundColor="{StaticResource BackgroundCard}"
                   BorderColor="{StaticResource VerdeLight}"
                   CornerRadius="12"
                   Padding="20"
                   HasShadow="False"
                   Margin="0,0,0,30">
                <VerticalStackLayout Spacing="8">
                    <Label Text="¿Qué pasa ahora?"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource VerdePrimary}"/>
                    <Label Text="• Un administrador del sitio revisará tu solicitud"
                           FontSize="13"
                           TextColor="{StaticResource TextoPrincipal}"/>
                    <Label Text="• Cuando sea aprobada, podrás iniciar sesión con tu email y contraseña"
                           FontSize="13"
                           TextColor="{StaticResource TextoPrincipal}"/>
                    <Label Text="• Te recomendamos volver a intentar ingresar en unas horas"
                           FontSize="13"
                           TextColor="{StaticResource TextoPrincipal}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Boton para volver a intentar el login -->
            <Frame BackgroundColor="{StaticResource VerdePrimary}"
                   BorderColor="Transparent"
                   CornerRadius="14"
                   Padding="0"
                   HeightRequest="52"
                   HasShadow="True"
                   Margin="0,0,0,12">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnIntentarLoginTapped"/>
                </Frame.GestureRecognizers>
                <Label Text="Probar iniciar sesión"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
            </Frame>

            <!-- Boton volver a sitios -->
            <Frame BackgroundColor="Transparent"
                   BorderColor="{StaticResource BordeMedio}"
                   CornerRadius="14"
                   Padding="0"
                   HeightRequest="52"
                   HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverSitiosTapped"/>
                </Frame.GestureRecognizers>
                <Label Text="Volver al inicio"
                       FontSize="15"
                       TextColor="{StaticResource TextoSecundario}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
            </Frame>

        </VerticalStackLayout>
    </Grid>

</ContentPage>
