<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================ -->
    <!-- PALETA PRINCIPAL - Blanco con tinte verdoso elegante         -->
    <!-- ============================================================ -->

    <!-- Fondos -->
    <Color x:Key="BackgroundPrimary">#F7FAFC</Color>
    <!-- antes #FAFBF8 -->
    <Color x:Key="BackgroundCard">#FFFFFF</Color>
    <!-- igual -->
    <Color x:Key="BackgroundSecondary">#EAF5FB</Color>
    <!-- antes #F4F7F0 -->

    <!-- "Verdes" (ahora celestes, pero mantenemos el nombre) -->
    <Color x:Key="VerdePrimary">#5DADE2</Color>
    <!-- antes #6B8E5A -->
    <Color x:Key="VerdePrimaryDark">#3498DB</Color>
    <!-- antes #557048 -->
    <Color x:Key="VerdeLight">#EAF5FB</Color>
    <!-- antes #E8F0E2 -->
    <Color x:Key="VerdeAccent">#85C1E9</Color>
    <!-- antes #8FB07A -->

    <!-- Textos -->
    <Color x:Key="TextoPrincipal">#1B3A4B</Color>
    <!-- antes #2C3E2D -->
    <Color x:Key="TextoSecundario">#7895A3</Color>
    <!-- antes #7A8A7B -->

    <!-- (los textos sobre verde quedan igual: #FFFFFF) -->
    <Color x:Key="TextoSobreVerde">#FFFFFF</Color>

    <!-- Estados -->
    <Color x:Key="ColorExito">#5B8C3E</Color>
    <!-- Verde más vivo para success -->
    <Color x:Key="ColorError">#C25450</Color>
    <!-- Rojo apagado (no chillón) -->
    <Color x:Key="ColorAdvertencia">#D4A04A</Color>
    <!-- Amarillo-marrón para warnings -->
    <Color x:Key="ColorInfo">#5A8B9E</Color>
    <!-- Azul-gris para info -->

    <!-- Bordes y separadores -->
    <Color x:Key="BordeSuave">#E8F0E2</Color>
    <Color x:Key="BordeMedio">#CFD8C5</Color>

    <!-- Para compatibilidad con sistema (light/dark) -->
    <Color x:Key="Primary">#6B8E5A</Color>
    <Color x:Key="PrimaryDark">#557048</Color>
    <Color x:Key="Secondary">#8FB07A</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#2C3E2D</Color>
    <Color x:Key="Gray100">#FAFBF8</Color>
    <Color x:Key="Gray200">#F4F7F0</Color>
    <Color x:Key="Gray300">#E8F0E2</Color>
    <Color x:Key="Gray400">#CFD8C5</Color>
    <Color x:Key="Gray500">#7A8A7B</Color>
    <Color x:Key="Gray600">#5A6A5B</Color>
    <Color x:Key="Gray900">#2C3E2D</Color>

</ResourceDictionary>
