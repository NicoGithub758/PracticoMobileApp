<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================ -->
    <!-- ESTILOS GLOBALES                                              -->
    <!-- ============================================================ -->

    <!-- Por defecto: aplicar a TODA la app -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundPrimary}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ============================================================ -->
    <!-- BOTONES                                                       -->
    <!-- ============================================================ -->

    <!-- Boton primario (verde) -->
    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource VerdePrimary}" />
        <Setter Property="TextColor" Value="{StaticResource TextoSobreVerde}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <!-- Boton secundario (outline) -->
    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource VerdePrimary}" />
        <Setter Property="BorderColor" Value="{StaticResource VerdePrimary}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <!-- Boton fantasma (texto solo) -->
    <Style x:Key="BotonFantasma" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource VerdePrimary}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Boton peligro (rojo apagado) -->
    <Style x:Key="BotonPeligro" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorError}" />
        <Setter Property="TextColor" Value="{StaticResource TextoSobreVerde}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- Boton default (sin estilo aplicado) -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource VerdePrimary}" />
        <Setter Property="TextColor" Value="{StaticResource TextoSobreVerde}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <!-- ============================================================ -->
    <!-- LABELS                                                        -->
    <!-- ============================================================ -->

    <Style x:Key="EstiloTituloPagina" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
    </Style>

    <Style x:Key="EstiloSubtitulo" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
    </Style>

    <Style x:Key="EstiloTextoNormal" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
    </Style>

    <Style x:Key="EstiloTextoSecundario" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextoSecundario}" />
    </Style>

    <!-- Label default -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- ============================================================ -->
    <!-- INPUTS (Entry, Editor)                                        -->
    <!-- ============================================================ -->

    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundCard}" />
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextoSecundario}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="50" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundCard}" />
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextoSecundario}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- ============================================================ -->
    <!-- FRAMES y BORDERS                                              -->
    <!-- ============================================================ -->

    <!-- Card principal (contenedor) -->
    <Style x:Key="Card" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundCard}" />
        <Setter Property="BorderColor" Value="{StaticResource VerdeLight}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <!-- Card destacada (con verde acento) -->
    <Style x:Key="CardDestacada" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundCard}" />
        <Setter Property="BorderColor" Value="{StaticResource VerdePrimary}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <!-- Frame default -->
    <Style TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundCard}" />
        <Setter Property="BorderColor" Value="{StaticResource VerdeLight}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <!-- ============================================================ -->
    <!-- OTROS                                                         -->
    <!-- ============================================================ -->

    <!-- ActivityIndicator -->
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource VerdePrimary}" />
    </Style>

    <!-- Switch -->
    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource VerdePrimary}" />
        <Setter Property="ThumbColor" Value="{StaticResource BackgroundCard}" />
    </Style>

    <!-- ProgressBar -->
    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource VerdePrimary}" />
    </Style>

    <!-- Picker -->
    <Style TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundCard}" />
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
        <Setter Property="TitleColor" Value="{StaticResource TextoSecundario}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- NavigationPage -->
    <Style TargetType="NavigationPage" ApplyToDerivedTypes="True">
        <Setter Property="BarBackgroundColor" Value="{StaticResource VerdePrimary}" />
        <Setter Property="BarTextColor" Value="{StaticResource TextoSobreVerde}" />
    </Style>

    <!-- Shell -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource VerdePrimary}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource TextoSobreVerde}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource TextoSobreVerde}" />
        <Setter Property="Shell.UnselectedColor" Value="#A5B89B" />
    </Style>

</ResourceDictionary>