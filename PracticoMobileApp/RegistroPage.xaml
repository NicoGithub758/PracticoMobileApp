<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PracticoMobileApp.RegistroPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Fill"
                             Padding="40,40"
                             Spacing="0">

            <!-- Logo del sitio (circular) -->
            <Image x:Name="SitioLogoImage"
                   Source="pencauy_logo.svg"
                   HeightRequest="130"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Margin="0,0,0,16"/>

            <Label Text="Crear cuenta"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextoPrincipal}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,4"/>

            <Label x:Name="SitioLabel"
                   Text=""
                   FontSize="13"
                   TextColor="{StaticResource VerdePrimary}"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,8"/>

            <!-- Aviso opcional -->
            <Label x:Name="AvisoLabel"
                   Text=""
                   FontSize="12"
                   TextColor="{StaticResource ColorAdvertencia}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   IsVisible="False"
                   Margin="0,0,0,16"/>

            <!-- Nombre -->
            <Label Text="Nombre"
                   FontSize="13"
                   TextColor="{StaticResource TextoSecundario}"
                   FontAttributes="Bold"
                   Margin="0,16,0,4"/>
            <Frame BackgroundColor="{StaticResource BackgroundCard}"
                   BorderColor="{StaticResource VerdeLight}"
                   CornerRadius="10"
                   Padding="14,0"
                   HeightRequest="50"
                   HasShadow="False"
                   Margin="0,0,0,12">
                <Entry x:Name="NombreEntry"
                       Placeholder="Tu nombre completo"
                       PlaceholderColor="{StaticResource TextoSecundario}"
                       TextColor="{StaticResource TextoPrincipal}"
                       BackgroundColor="Transparent"/>
            </Frame>

            <!-- Email -->
            <Label Text="Email"
                   FontSize="13"
                   TextColor="{StaticResource TextoSecundario}"
                   FontAttributes="Bold"
                   Margin="0,0,0,4"/>
            <Frame BackgroundColor="{StaticResource BackgroundCard}"
                   BorderColor="{StaticResource VerdeLight}"
                   CornerRadius="10"
                   Padding="14,0"
                   HeightRequest="50"
                   HasShadow="False"
                   Margin="0,0,0,12">
                <Entry x:Name="EmailEntry"
                       Placeholder="tu@email.com"
                       PlaceholderColor="{StaticResource TextoSecundario}"
                       TextColor="{StaticResource TextoPrincipal}"
                       Keyboard="Email"
                       BackgroundColor="Transparent"/>
            </Frame>

            <!-- Password -->
            <Label Text="Contraseña"
                   FontSize="13"
                   TextColor="{StaticResource TextoSecundario}"
                   FontAttributes="Bold"
                   Margin="0,0,0,4"/>
            <Frame BackgroundColor="{StaticResource BackgroundCard}"
                   BorderColor="{StaticResource VerdeLight}"
                   CornerRadius="10"
                   Padding="14,0"
                   HeightRequest="50"
                   HasShadow="False"
                   Margin="0,0,0,12">
                <Entry x:Name="PasswordEntry"
                       Placeholder="Mínimo 6 caracteres"
                       PlaceholderColor="{StaticResource TextoSecundario}"
                       TextColor="{StaticResource TextoPrincipal}"
                       IsPassword="True"
                       BackgroundColor="Transparent"/>
            </Frame>

            <!-- Confirmar password -->
            <Label Text="Confirmar contraseña"
                   FontSize="13"
                   TextColor="{StaticResource TextoSecundario}"
                   FontAttributes="Bold"
                   Margin="0,0,0,4"/>
            <Frame BackgroundColor="{StaticResource BackgroundCard}"
                   BorderColor="{StaticResource VerdeLight}"
                   CornerRadius="10"
                   Padding="14,0"
                   HeightRequest="50"
                   HasShadow="False"
                   Margin="0,0,0,12">
                <Entry x:Name="PasswordConfirmEntry"
                       Placeholder="Repetí la contraseña"
                       PlaceholderColor="{StaticResource TextoSecundario}"
                       TextColor="{StaticResource TextoPrincipal}"
                       IsPassword="True"
                       BackgroundColor="Transparent"/>
            </Frame>

            <!-- Token de invitacion (solo si TipoRegistro = SoloConInvitacion) -->
            <StackLayout x:Name="InvitacionStack" IsVisible="False">
                <Label Text="Código de invitación"
                       FontSize="13"
                       TextColor="{StaticResource TextoSecundario}"
                       FontAttributes="Bold"
                       Margin="0,0,0,4"/>
                <Frame BackgroundColor="{StaticResource BackgroundCard}"
                       BorderColor="{StaticResource ColorAdvertencia}"
                       CornerRadius="10"
                       Padding="14,0"
                       HeightRequest="50"
                       HasShadow="False"
                       Margin="0,0,0,12">
                    <Entry x:Name="TokenInvitacionEntry"
                           Placeholder="Pegá tu código aquí"
                           PlaceholderColor="{StaticResource TextoSecundario}"
                           TextColor="{StaticResource TextoPrincipal}"
                           BackgroundColor="Transparent"/>
                </Frame>
            </StackLayout>

            <!-- Boton de registro -->
            <Frame x:Name="RegistrarButton"
                   BackgroundColor="{StaticResource VerdePrimary}"
                   BorderColor="Transparent"
                   CornerRadius="14"
                   Padding="0"
                   HeightRequest="56"
                   HasShadow="True"
                   Margin="0,16,0,0">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRegistrarTapped"/>
                </Frame.GestureRecognizers>
                <Label Text="Crear cuenta"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
            </Frame>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="{StaticResource VerdePrimary}"
                               Margin="0,20,0,0"/>

            <Label x:Name="ErrorLabel"
                   Text=""
                   TextColor="{StaticResource ColorError}"
                   FontSize="13"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   IsVisible="False"
                   Margin="0,16,0,0"/>

            <!-- Volver -->
            <Label Text="← Volver"
                   FontSize="13"
                   TextColor="{StaticResource TextoSecundario}"
                   HorizontalOptions="Center"
                   Margin="0,32,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverTapped"/>
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
