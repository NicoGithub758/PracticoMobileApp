<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PracticoMobileApp.SitiosPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header con logo PencaUY (solo en esta pagina, las demas usan el del sitio) -->
        <VerticalStackLayout Grid.Row="0" Padding="30,50,30,20">
            <Image Source="pencauy_logo.svg"
                   HeightRequest="100"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"/>
            <Label Text="Elegí tu sitio para continuar"
                   FontSize="14"
                   TextColor="{StaticResource TextoSecundario}"
                   HorizontalOptions="Center"
                   Margin="0,12,0,0"/>
        </VerticalStackLayout>

        <!-- Loading -->
        <ActivityIndicator Grid.Row="1"
                           x:Name="LoadingIndicator"
                           IsRunning="True"
                           IsVisible="True"
                           Color="{StaticResource VerdePrimary}"
                           Margin="0,10,0,0"/>

        <!-- Lista de sitios -->
        <CollectionView Grid.Row="2"
                        x:Name="SitiosCollection"
                        Margin="20,10,20,0"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,6,0,6"
                            BackgroundColor="{StaticResource BackgroundCard}"
                            StrokeShape="RoundRectangle 14"
                            Stroke="{StaticResource VerdeLight}"
                            StrokeThickness="1"
                            Padding="0">
                        <Grid ColumnDefinitions="8,Auto,*" ColumnSpacing="0">
                            <!-- Barra de color del sitio -->
                            <BoxView Grid.Column="0"
                                     Color="{Binding ColorPrincipal, TargetNullValue='#6B8E5A'}"
                                     WidthRequest="8"
                                     HorizontalOptions="Fill"/>

                            <!-- Logo del sitio (circular) -->
                            <Border Grid.Column="1"
                                    WidthRequest="56"
                                    HeightRequest="56"
                                    Margin="14,14,0,14"
                                    StrokeShape="RoundRectangle 28"
                                    Stroke="{StaticResource VerdeLight}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource BackgroundSecondary}"
                                    Padding="0">
                                <Image Source="{Binding LogoUrl, TargetNullValue='pencauy_icon.svg', FallbackValue='pencauy_icon.svg'}"
                                       Aspect="AspectFill"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="2" Padding="14,14,16,14" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Nombre}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextoPrincipal}"/>
                                <Label Text="{Binding Descripcion}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextoSecundario}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"/>
                                <Label Text="{Binding TipoRegistro}"
                                       FontSize="11"
                                       TextColor="{StaticResource VerdePrimary}"
                                       FontAttributes="Bold"
                                       Margin="0,4,0,0"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSitioTapped"
                                                  CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Error message -->
        <Label Grid.Row="2"
               x:Name="ErrorLabel"
               Text="No se pudieron cargar los sitios.&#10;Verificá tu conexión."
               TextColor="{StaticResource ColorError}"
               FontSize="14"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               HorizontalTextAlignment="Center"
               IsVisible="False"/>

        <!-- Footer -->
        <Label Grid.Row="3"
               Text="Seleccioná un sitio para ingresar"
               FontSize="12"
               TextColor="{StaticResource TextoSecundario}"
               HorizontalOptions="Center"
               Margin="0,10,0,30"/>

    </Grid>
</ContentPage>
