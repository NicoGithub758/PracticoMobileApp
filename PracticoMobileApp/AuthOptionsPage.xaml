<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PracticoMobileApp.AuthOptionsPage"
             Shell.NavBarIsVisible="False">

    <Grid>
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Fill"
                             Padding="40"
                             Spacing="0">

            <!-- Logo -->
            <Image Source="pencauy_logo.svg"
                   HeightRequest="160"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Margin="0,0,0,16"/>

            <Label x:Name="SitioLabel"
                   Text=""
                   FontSize="14"
                   TextColor="{StaticResource VerdePrimary}"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,8"/>

            <!-- Aviso opcional (ej: 'Tu solicitud requerirá aprobación') -->
            <Label x:Name="AvisoLabel"
                   Text=""
                   FontSize="12"
                   TextColor="{StaticResource ColorAdvertencia}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   IsVisible="False"
                   Margin="20,0,20,30"/>

            <!-- Boton Login interno -->
            <Frame x:Name="LoginInternoButton"
                   BackgroundColor="{StaticResource VerdePrimary}"
                   BorderColor="Transparent"
                   CornerRadius="14"
                   Padding="0"
                   HeightRequest="56"
                   HasShadow="True"
                   Margin="0,20,0,12">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLoginInternoTapped"/>
                </Frame.GestureRecognizers>
                <Label Text="Iniciar sesión"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
            </Frame>

            <!-- Boton Registrarse -->
            <Frame x:Name="RegistrarseButton"
                   BackgroundColor="{StaticResource BackgroundCard}"
                   BorderColor="{StaticResource VerdePrimary}"
                   CornerRadius="14"
                   Padding="0"
                   HeightRequest="56"
                   HasShadow="False"
                   Margin="0,0,0,12">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRegistrarseTapped"/>
                </Frame.GestureRecognizers>
                <Label Text="Crear cuenta"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource VerdePrimary}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
            </Frame>

            <!-- Separador OR -->
            <Label x:Name="OrLabel"
                   Text="— ó —"
                   FontSize="12"
                   TextColor="{StaticResource TextoSecundario}"
                   HorizontalOptions="Center"
                   Margin="0,8,0,8"/>

            <!-- Boton Google -->
            <Frame x:Name="GoogleButton"
                   BackgroundColor="White"
                   BorderColor="{StaticResource BordeMedio}"
                   CornerRadius="14"
                   Padding="0"
                   HeightRequest="56"
                   HasShadow="True">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGoogleLoginTapped"/>
                </Frame.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="20,0">
                    <Label Grid.Column="0"
                           Text="G"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#4285F4"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="Continuar con Google"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextoPrincipal}"
                           VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="{StaticResource VerdePrimary}"
                               Margin="0,20,0,0"/>

            <Label x:Name="ErrorLabel"
                   Text=""
                   TextColor="{StaticResource ColorError}"
                   FontSize="13"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   IsVisible="False"
                   Margin="0,16,0,0"/>

        </VerticalStackLayout>

        <!-- Volver a sitios -->
        <Label Text="← Cambiar sitio"
               FontSize="13"
               TextColor="{StaticResource TextoSecundario}"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,0,0,30">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnVolverTapped"/>
            </Label.GestureRecognizers>
        </Label>
    </Grid>

</ContentPage>
